{
  "name": "easy-docket",
  "version": "0.0.1",
  "author": "xiidea",
  "homepage": "https://github.com/xiidea/easy-docket",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "lint": "ng lint",
    "cap:sync": "ng build && cap sync android",
    "android:open": "npm run cap:sync && cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "ng build && playwright test",
    "icons": "node tools/render-icons.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/platform-browser-dynamic": "22.0.1",
    "@angular/router": "22.0.1",
    "@angular/service-worker": "22.0.1",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.7",
    "@ionic/angular": "^9.0.0",
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "buffer": "^6.0.3",
    "capacitor-secure-storage-plugin": "^0.11.0",
    "dexie": "^4.4.6",
    "ionicons": "^8.1.0",
    "isomorphic-git": "^1.42.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "8.5.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "fake-indexeddb": "^6.2.5",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "description": "Offline-first personal money manager with end-to-end encrypted, pluggable sync.",
